                  >
                    <i className="fas fa-sync-alt me-2"></i>
                    Refresh
                  </button>
                </div>
              </div>
            </div>
          </div>

          {/* Simple Metrics Row */}
          <div className="row mb-4">
            {/* Today's Sales Card */}
            <div className="col-lg-6 col-md-6 mb-4">
              <div className="card metric-card-simple border-0 shadow-sm h-100" style={{ background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)', minHeight: '140px' }}>
                <div className="card-body d-flex align-items-center justify-content-between p-4">
                  <div className="text-white">
                    <h5 className="metric-label-simple text-white-50 mb-2 fw-normal">Today's Sales</h5>
                    <h3 className="metric-value-simple text-white mb-2 fw-bold">
                      {currency}{todaySummary.todaySales.toLocaleString()}
                    </h3>
                    <p className="text-white-50 mb-0 small">
                      <i className="fas fa-shopping-cart me-2"></i>
                      {summary.transactionsCount} orders today
                    </p>
                  </div>
                  <div className="metric-icon-simple bg-white bg-opacity-20 rounded-circle d-flex align-items-center justify-content-center" style={{ width: '60px', height: '60px' }}>
                    <i className="fas fa-chart-line text-white fs-4"></i>
                  </div>
                </div>
              </div>
            </div>

            {/* Average Order Value Card */}
            <div className="col-lg-6 col-md-6 mb-4">
              <div className="card metric-card-simple border-0 shadow-sm h-100" style={{ background: 'linear-gradient(135deg, #10b981 0%, #059669 100%)', minHeight: '140px' }}>
                <div className="card-body d-flex align-items-center justify-content-between p-4">
                  <div className="text-white">
                    <h5 className="metric-label-simple text-white-50 mb-2 fw-normal">Average Order Value</h5>
                    <h3 className="metric-value-simple text-white mb-2 fw-bold">
                      {currency}{summary.transactionsCount > 0 ? Math.round(todaySummary.todaySales / summary.transactionsCount).toLocaleString() : 0}
                    </h3>
                    <p className="text-white-50 mb-0 small">
                      <i className="fas fa-exclamation-triangle me-2"></i>
                      {lowStockAlerts.length} stock alerts
                    </p>
                  </div>
                  <div className="metric-icon-simple bg-white bg-opacity-20 rounded-circle d-flex align-items-center justify-content-center" style={{ width: '60px', height: '60px' }}>
                    <i className="fas fa-chart-bar text-white fs-4"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* Charts Section */}
          <div className="row">
            {/* Sales vs Purchase Comparison */}
            <div className="col-lg-6 col-md-12 mb-4">
              <div className="card border-0 shadow-sm">
                <div className="card-header bg-white border-0 pb-0">
                  <h5 className="card-title mb-0 text-dark">Sales vs Purchase Comparison</h5>
                  <p className="text-muted small mb-0">Monthly performance overview</p>
                </div>
                <div className="card-body pt-3">
                  <ResponsiveContainer width="100%" height={300}>
                    <ComposedChart data={salesData.slice(-12)}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#f1f5f9" />
                      <XAxis dataKey="month" stroke="#64748b" fontSize={12} />
                      <YAxis stroke="#64748b" fontSize={12} />
                      <Tooltip 
                        contentStyle={{ 
                          backgroundColor: '#ffffff', 
                          border: '1px solid #e2e8f0',
                          borderRadius: '8px',
                          boxShadow: '0 4px 12px rgba(0, 0, 0, 0.1)'
                        }} 
                      />
                      <Legend />
                      <Bar dataKey="sales" fill="#667eea" name="Sales" radius={[4, 4, 0, 0]} />
                      <Bar dataKey="purchases" fill="#10b981" name="Purchases" radius={[4, 4, 0, 0]} />
                      <Line type="monotone" dataKey="profit" stroke="#f59e0b" strokeWidth={3} name="Profit" />
                    </ComposedChart>
                  </ResponsiveContainer>
                </div>
              </div>
            </div>

            {/* Sales Trend */}
            <div className="col-lg-6 col-md-12 mb-4">
              <div className="card border-0 shadow-sm">
                <div className="card-header bg-white border-0 pb-0">
                  <h5 className="card-title mb-0 text-dark">Sales Trend</h5>
                  <p className="text-muted small mb-0">Revenue growth analysis</p>
                </div>
                <div className="card-body pt-3">
                  <ResponsiveContainer width="100%" height={300}>
                    <AreaChart data={salesData.slice(-12)}>
                      <defs>
                        <linearGradient id="salesGradient" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="5%" stopColor="#667eea" stopOpacity={0.3}/>
                          <stop offset="95%" stopColor="#667eea" stopOpacity={0.1}/>
                        </linearGradient>
                      </defs>
                      <CartesianGrid strokeDasharray="3 3" stroke="#f1f5f9" />
                      <XAxis dataKey="month" stroke="#64748b" fontSize={12} />
                      <YAxis stroke="#64748b" fontSize={12} />
                      <Tooltip 
                        contentStyle={{ 
                          backgroundColor: '#ffffff', 
                          border: '1px solid #e2e8f0',
                          borderRadius: '8px',
                          boxShadow: '0 4px 12px rgba(0, 0, 0, 0.1)'
                        }} 
                      />
                      <Area 
                        type="monotone" 
                        dataKey="sales" 
                        stroke="#667eea" 
                        strokeWidth={3}
                        fill="url(#salesGradient)" 
                        name="Sales Revenue"
                      />
                    </AreaChart>
                  </ResponsiveContainer>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </Layout>
  );
}