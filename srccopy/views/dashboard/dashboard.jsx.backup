                  </h2>
                  <p className="mb-0 mt-1" style={{ opacity: '0.9', fontSize: '0.95rem' }}>
                    Monitor your business performance and daily operations
                  </p>
                </div>
                <div className="d-flex gap-2">
                  <Link 
                    to="/day-close" 
                    className="btn btn-light btn-sm px-3"
                    style={{ 
