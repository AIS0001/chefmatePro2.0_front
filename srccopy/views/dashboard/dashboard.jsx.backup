                boxShadow: '0 8px 32px rgba(0, 0, 0, 0.1)'
              }}>
                <div>
                  <h2 className="mb-0" style={{ fontWeight: '600' }}>
                    <i className="fas fa-tachometer-alt me-2"></i>
