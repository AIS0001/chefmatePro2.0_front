# Thermal Printer Agent Configuration

# Server Configuration
PORT=7001

# Printer Configuration
# Options: windows, usb, network
PRINTER_TYPE=network

# Printer Name (optional, uses default Windows printer if not specified)
# PRINTER_NAME=Your Printer Name

# Single Network Printer Settings (fallback if multi-printer not configured)
# (Cashier) IP 192.168.1.216
PRINTER_IP=192.168.1.216 
PRINTER_PORT=9100

# ============================================
# Multi-Printer Configuration (Simultaneous)
# ============================================
# Enable multi-printer mode for sending commands to multiple IP addresses
# Set printer IPs for Kitchen, Cashier, Kiosk, etc.

# Printer 1 Configuration (Cashier Printer)
PRINTER_1_IP=192.168.1.216
PRINTER_1_PORT=9100

# Printer 2 Configuration (Kitchen Printer)
PRINTER_2_IP=192.168.1.217
PRINTER_2_PORT=9100++++++++++++++++++++++++

# Printer 3 Configuration (Kiosk Printer) - Optional
# PRINTER_3_IP=192.168.1.102
# PRINTER_3_PORT=9100

# ============================================
# Printer Modes
# ============================================
# MULTI_PRINTER_MODE=sequential    # one by one (prevents network congestion)
# MULTI_PRINTER_MODE=simultaneous  # all at once (faster but more load)
MULTI_PRINTER_MODE=simultaneous

# Retry Configuration
PRINTER_RETRY_ATTEMPTS=2
PRINTER_RETRY_DELAY=500

# Timeout Configuration (in milliseconds)
PRINTER_TIMEOUT=5000

# ============================================
# Example Configuration for Different Scenarios
# ============================================

# Scenario 1: Kitchen + Cashier (Most Common)
# PRINTER_1_IP=192.168.1.100  (Kitchen)
# PRINTER_2_IP=192.168.1.101  (Cashier)

# Scenario 2: All Printers (Kitchen + Cashier + Kiosk)
# PRINTER_1_IP=192.168.1.100  (Kitchen)
# PRINTER_2_IP=192.168.1.101  (Cashier)
# PRINTER_3_IP=192.168.1.102  (Kiosk)

# Scenario 3: Different Ports
# PRINTER_1_IP=192.168.1.100
# PRINTER_1_PORT=9100
# PRINTER_2_IP=192.168.1.101
# PRINTER_2_PORT=9101
